# =============================================================
# ARCHIVO: .env.example
# DESCRIPCIÓN: Plantilla de variables de entorno para Playa Alerta.
#              Copia este archivo como ".env" y rellena los valores.
# =============================================================

# ── SUPABASE (Recomendado para Vercel y producción) ──────────
# Obtén estos valores en: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key_aqui
# Opcional (para omitir RLS en backend si fuera necesario):
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ── PUERTO LOCAL ─────────────────────────────────────────────
PORT=3000

# ── AIVEN MYSQL (Legacy / Opcional si usas MySQL) ─────────────
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=28776
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=tu_password_aqui
